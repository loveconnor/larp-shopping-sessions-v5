+#[cfg(all(target_arch = "x86_64", target_feature = "avx2", not(target_feature = "avx512f")))]
+fn sort_history_blocks(values: &mut [u64], scratch: &mut [u64]) {
+    use std::arch::x86_64::*;
+    let n = values.len();
+    if n <= 32 {
+        values.sort_unstable();
+        return;
+    }
+    let middle = n.next_power_of_two() / 2;
+    let (left, right) = values.split_at_mut(middle);
+    let (a, b) = scratch.split_at_mut(middle);
+    sort_history_blocks(left, a);
+    sort_history_blocks(right, b);
+    unsafe {
+        let sign = _mm256_set1_epi64x(i64::MIN);
+        let lanes = _mm256_setr_epi64x(0, 1, 2, 3);
+        let upper = _mm256_setr_epi64x(0, 0, -1, -1);
+        let odd = _mm256_setr_epi64x(0, -1, 0, -1);
+        let split = |a, b| {
+            let exchange = _mm256_cmpgt_epi64(a,b);
+            (_mm256_blendv_epi8(a,b,exchange), _mm256_blendv_epi8(b,a,exchange))
+        };
+        let stage = |v, other, upper| {
+            let choose = _mm256_xor_si256(_mm256_cmpgt_epi64(v,other),upper);
+            _mm256_blendv_epi8(v,other,choose)
+        };
+        let finish = |v| {
+            let v = stage(v, _mm256_permute4x64_epi64::<0x4e>(v), upper);
+            stage(v, _mm256_permute4x64_epi64::<0xb1>(v), odd)
+        };
+        let load = |p: *const u64| _mm256_xor_si256(_mm256_loadu_si256(p.cast()), sign);
+        let mut carry = load(left.as_ptr());
+        let (mut x, mut y, mut written) = (4, 0, 0);
+        while x < left.len() || y < right.len() {
+            let block = if y == right.len() || (x < left.len() && left[x] <= right[y]) {
+                let v = load(left.as_ptr().add(x));
+                x += 4;
+                v
+            } else if right.len() - y >= 4 {
+                let v = load(right.as_ptr().add(y));
+                y += 4;
+                v
+            } else {
+                let valid = _mm256_cmpgt_epi64(_mm256_set1_epi64x((right.len()-y) as i64), lanes);
+                let raw = _mm256_maskload_epi64(right.as_ptr().add(y).cast(),valid);
+                y = right.len();
+                _mm256_blendv_epi8(_mm256_set1_epi64x(i64::MAX),_mm256_xor_si256(raw,sign),valid)
+            };
+            let (low, high) = split(carry, _mm256_permute4x64_epi64::<0x1b>(block));
+            carry = finish(high);
+            _mm256_storeu_si256(scratch.as_mut_ptr().add(written).cast(),_mm256_xor_si256(finish(low), sign));
+            written += 4;
+        }
+        let valid = _mm256_cmpgt_epi64(_mm256_set1_epi64x((n-written) as i64),lanes);
+        _mm256_maskstore_epi64(scratch.as_mut_ptr().add(written).cast(),valid,_mm256_xor_si256(carry,sign));
+    }
+    values.copy_from_slice(&scratch[..n]);
+}
