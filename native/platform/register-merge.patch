+#[cfg(all(target_arch = "x86_64", target_feature = "avx512f"))]
+#[inline]
+unsafe fn merge_histories<const REGISTERS: usize>(values: &mut [u64]) {
+    use std::arch::x86_64::*;
+    let half = 8 * REGISTERS;
+    debug_assert!(values.len() > half && values.len() <= 2 * half);
+    let (left, right) = values.split_at_mut(half);
+    unsafe {
+        debug_assert!(left.is_sorted() && right.is_sorted());
+        let reverse = _mm512_setr_epi64(7, 6, 5, 4, 3, 2, 1, 0);
+        let split = |a, b| (_mm512_min_epu64(a, b), _mm512_max_epu64(a, b));
+        let lanes = |offset| (0xffu16 >> (8 - right.len().saturating_sub(offset).min(8))) as u8;
+        let mut low = [_mm512_setzero_si512(); REGISTERS];
+        let mut high = low;
+        for i in 0..REGISTERS {
+            let a = _mm512_loadu_si512(left.as_ptr().add(8 * i).cast());
+            let offset = 8 * (REGISTERS - 1 - i);
+            let b = _mm512_mask_loadu_epi64(_mm512_set1_epi64(-1), lanes(offset),
+                right.as_ptr().wrapping_add(offset).cast());
+            (low[i], high[i]) = split(a, _mm512_permutexvar_epi64(reverse, b));
+        }
+        // After the cross-half split, merge each bitonic half from the
+        // widest register separation down to individual lanes.
+        let merge = |mut v: [__m512i; REGISTERS]| {
+            let mut gap = REGISTERS / 2;
+            while gap != 0 {
+                for base in (0..REGISTERS).step_by(2 * gap) {
+                    for j in base..base + gap {
+                        (v[j], v[j + gap]) = split(v[j], v[j + gap]);
+                    }
+                }
+                gap /= 2;
+            }
+            v.map(|v| {
+                let w = _mm512_permutexvar_epi64(_mm512_setr_epi64(4,5,6,7,0,1,2,3), v);
+                let v = _mm512_mask_max_epu64(_mm512_min_epu64(v,w),0xf0,v,w);
+                let w = _mm512_permutexvar_epi64(_mm512_setr_epi64(2,3,0,1,6,7,4,5), v);
+                let v = _mm512_mask_max_epu64(_mm512_min_epu64(v,w),0xcc,v,w);
+                let w = _mm512_permutexvar_epi64(_mm512_setr_epi64(1,0,3,2,5,4,7,6), v);
+                _mm512_mask_max_epu64(_mm512_min_epu64(v,w),0xaa,v,w)
+            })
+        };
+        let masks: [u8; REGISTERS] = std::array::from_fn(|i| lanes(i * 8));
+        for (i, v) in merge(low).into_iter().enumerate() {
+            _mm512_storeu_si512(left.as_mut_ptr().add(i * 8).cast(), v);
+        }
+        for (i, v) in merge(high).into_iter().enumerate() {
+            _mm512_mask_storeu_epi64(right.as_mut_ptr().wrapping_add(i * 8).cast(), masks[i], v);
+        }
+    }
+}
